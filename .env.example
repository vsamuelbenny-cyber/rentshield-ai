# RentShield AI - Environment Variables
# Copy to .env for local overrides if needed

# Backend Environment
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./rentshield.sqlite3

# Uploads and Image Hashing
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5
HASH_SIMILARITY_THRESHOLD=8

# Optional External AI API (e.g. OpenAI/Gemini/Anthropic for optional advanced text summarization)
# Note: RentShield AI functions 100% locally with rule-based heuristics if no API key is provided!
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_MODEL=gpt-4o-mini
